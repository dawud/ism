entrypoint typedef struct _dns_uncompressed_question_name_rdata_answer_packet (
  UINT32 qname_length,
  UINT32 rr_name_length,
  UINT32 rdata_name_length,
  UINT32 expected_rtype
)
where qname_length >= 1 && qname_length <= 255 &&
      rr_name_length >= 1 && rr_name_length <= 255 &&
      rdata_name_length >= 1 && rdata_name_length <= 255 &&
      (expected_rtype == 2 || expected_rtype == 5 || expected_rtype == 12)
{
  UINT16BE id;
  dns_flags flags;
  UINT16BE qdcount { qdcount == 1 };
  UINT16BE ancount { ancount == 1 };
  UINT16BE nscount { nscount == 0 };
  UINT16BE arcount { arcount == 0 };
  dns_label question_labels[:byte-size (qname_length - 1)];
  UINT8 question_root { question_root == 0 };
  UINT16BE qtype;
  UINT16BE qclass;
  dns_label rr_name_labels[:byte-size (rr_name_length - 1)];
  UINT8 rr_name_root { rr_name_root == 0 };
  UINT16BE rtype { rtype == expected_rtype };
  UINT16BE rclass;
  UINT32BE ttl;
  UINT16BE rdlength { rdlength == rdata_name_length };
  dns_label rdata_name_labels[:byte-size (rdata_name_length - 1)];
  UINT8 rdata_name_root { rdata_name_root == 0 };
} dns_uncompressed_question_name_rdata_answer_packet;

