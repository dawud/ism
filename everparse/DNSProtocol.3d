  UINT16BE qtype;
  UINT16BE qclass;
  dns_label rr_name_labels[:byte-size (rr_name_length - 1)];
  UINT8 rr_name_root { rr_name_root == 0 };
  UINT16BE rtype { rtype == 1 };
  UINT16BE rclass;
  UINT32BE ttl;
  UINT16BE rdlength { rdlength == 4 };
  UINT8 rdata[4];
} dns_uncompressed_question_a_answer_packet;

