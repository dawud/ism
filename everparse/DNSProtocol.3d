// DNS wire-format seed for the EverParse production parser boundary.
// This starts with fixed-size RFC 1035 header validation, bounded
// uncompressed QNAME question validation, a first single-answer RR subset, and
// fixed-RDLENGTH A/AAAA answer subsets, first name-RDATA answer subsets, the
// first MX answer subset, the first SOA answer subset, the first SRV answer
// subset, the first TXT answer subset, the first EDNS0 OPT additional-RR
// subset, the first compressed-owner answer subset, the first compressed
// name-RDATA answer subset, and the first compressed MX exchange answer
// subset. Broader RR-section validation remains in the handwritten reference
// parser until the generated boundary is expanded.

typedef struct _dns_flags {
  UINT16BE qr : 1;
  UINT16BE opcode : 4;
  UINT16BE aa : 1;
  UINT16BE tc : 1;
  UINT16BE rd : 1;
  UINT16BE ra : 1;
  UINT16BE z : 1;
  UINT16BE ad : 1;
  UINT16BE cd : 1;
  UINT16BE rcode : 4;
} dns_flags;

entrypoint typedef struct _dns_header {
  UINT16BE id;
  dns_flags flags;
  UINT16BE qdcount;
  UINT16BE ancount;
  UINT16BE nscount;
  UINT16BE arcount;
} dns_header;

entrypoint typedef struct _dns_root_question {
  UINT8 root { root == 0 };
  UINT16BE qtype;
  UINT16BE qclass;
} dns_root_question;

entrypoint typedef struct _dns_single_label_question (UINT32 label_length)
where label_length > 0 && label_length <= 63
{
  UINT8 label_len { label_len == label_length };
  UINT8 label[label_length];
  UINT8 root { root == 0 };
  UINT16BE qtype;
  UINT16BE qclass;
} dns_single_label_question;

entrypoint typedef struct _dns_two_label_question (UINT32 first_label_length, UINT32 second_label_length)
where first_label_length > 0 && first_label_length <= 63 &&
      second_label_length > 0 && second_label_length <= 63
{
  UINT8 first_label_len { first_label_len == first_label_length };
  UINT8 first_label[first_label_length];
  UINT8 second_label_len { second_label_len == second_label_length };
  UINT8 second_label[second_label_length];
  UINT8 root { root == 0 };
  UINT16BE qtype;
  UINT16BE qclass;
} dns_two_label_question;

typedef struct _dns_label {
  UINT8 label_len { label_len > 0 && label_len <= 63 };
  UINT8 label[label_len];
} dns_label;

typedef struct _dns_txt_string {
  UINT8 string_len;
  UINT8 text[string_len];
} dns_txt_string;

typedef struct _dns_edns_option {
  UINT16BE option_code;
  UINT16BE option_length;
  UINT8 option_data[option_length];
} dns_edns_option;

entrypoint typedef struct _dns_uncompressed_question (UINT32 qname_length)
where qname_length >= 1 && qname_length <= 255
{
  dns_label labels[:byte-size (qname_length - 1)];
  UINT8 root { root == 0 };
  UINT16BE qtype;
  UINT16BE qclass;
} dns_uncompressed_question;

entrypoint typedef struct _dns_uncompressed_question_answer_packet (
  UINT32 qname_length,
  UINT32 rr_name_length,
  UINT32 rdata_length
)
where qname_length >= 1 && qname_length <= 255 &&
      rr_name_length >= 1 && rr_name_length <= 255 &&
      rdata_length <= 65535
{
  UINT16BE id;
  dns_flags flags;
  UINT16BE qdcount { qdcount == 1 };
  UINT16BE ancount { ancount == 1 };
  UINT16BE nscount { nscount == 0 };
  UINT16BE arcount { arcount == 0 };
  dns_label question_labels[:byte-size (qname_length - 1)];
  UINT8 question_root { question_root == 0 };
  UINT16BE qtype;
  UINT16BE qclass;
  dns_label rr_name_labels[:byte-size (rr_name_length - 1)];
  UINT8 rr_name_root { rr_name_root == 0 };
  UINT16BE rtype;
  UINT16BE rclass;
  UINT32BE ttl;
  UINT16BE rdlength { rdlength == rdata_length };
  UINT8 rdata[rdata_length];
} dns_uncompressed_question_answer_packet;

entrypoint typedef struct _dns_uncompressed_question_a_answer_packet (
