  UINT16BE rtype { rtype == expected_rtype };
  UINT16BE rclass;
  UINT32BE ttl;
  UINT16BE rdlength { rdlength == 2 };
  UINT8 rdata_name_ptr_hi { rdata_name_ptr_hi == 192 };
  UINT8 rdata_name_ptr_lo { rdata_name_ptr_lo == 12 };
